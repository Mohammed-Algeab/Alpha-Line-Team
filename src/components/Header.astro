---
// Chronos Archive: يعرض الهاتف قفلًا مصغرًا حتى يبقى اسم Alpha Line ظاهرًا، ويستخدم السطح القفل التحريري الكامل.
import BrandMark from "./BrandMark.astro";
import contact from "../content/site.json";
import "../styles/brand-lockup.css";
const { active = "" } = Astro.props;
const links = [{ href: "/", label: "الرئيسية", key: "home" }, { href: "/translations/", label: "التعريبات", key: "translations" }, { href: "/blog/", label: "المدونة", key: "blog" }, { href: "/about/", label: "حول الفريق", key: "about" }];
const hasContactChannel = contact.contactChannels.some((channel) => channel.enabled && channel.href);
const hasCommunityChannel = contact.contactChannels.some((channel) => (channel.id === "telegram" || channel.id === "discord") && channel.enabled && channel.href);
---
<header class="site-header"><a class="brand-lockup" href="/" aria-label="Alpha Line / ألفا لاين — الرئيسية"><span class="brand-logo-mobile"><BrandMark variant="compact" /></span><span class="brand-desktop-lockup"><BrandMark variant="lockup" /></span></a><nav class="desktop-nav" aria-label="التنقل الرئيسي">{links.map((link) => <a href={link.href} class:list={{ active: active === link.key }}>{link.label}</a>)}</nav><div class="header-actions">{hasCommunityChannel && <a class="icon-button community-button" href="/contact/" aria-label="مجتمع Alpha Line"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h11a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3H9l-4 3v-3.4a3 3 0 0 1-1-2.3v-5a3 3 0 0 1 3-3Z"/><path d="M8 10h6M8 13h4"/></svg></a>}<a class="icon-button" href="/search/" aria-label="البحث"><span aria-hidden="true">⌕</span></a><details class="mobile-menu"><summary class="icon-button" aria-label="فتح القائمة"><span aria-hidden="true">☰</span></summary><nav aria-label="قائمة الهاتف">{links.map((link) => <a href={link.href}>{link.label}<span>←</span></a>)}{hasContactChannel && <a href="/contact/">تواصل معنا<span>←</span></a>}</nav></details></div></header>
