---
// هوية «أطلس المسارات»: وضع المعاينة خاص افتراضيًا؛ الرابط وصورة المشاركة يخرجان من إعداد مركزي قابل للنقل لاحقًا.
import Header from "../components/Header.astro";
import MobileNav from "../components/MobileNav.astro";
import "../styles/global.css";
import "../styles/rtl-bidi.css";
import { assets, publication, site } from "../data/content";
interface Props { title: string; description?: string; active?: string; ogImage?: string; }
const { title, description = site.description, active = "", ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.origin).toString();
const socialImage = new URL(ogImage ?? assets.defaultOgImage, Astro.site ?? site.origin).toString();
const robots = publication.indexable ? "index,follow" : "noindex,nofollow,noarchive";
---
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#061825" /><meta name="description" content={description} /><meta name="robots" content={robots} /><link rel="canonical" href={canonical} /><meta property="og:type" content="website" /><meta property="og:locale" content="ar_AR" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={socialImage} /><meta property="og:image:alt" content={`${title} — Alpha Line`} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} /><link rel="icon" href="https://files.manuscdn.com/user_upload_by_module/session_file/310519663093354307/wpoZAiltieVJXTfx.png" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet" /><title>{title}</title></head><body><div class="site-shell"><Header active={active} /><main><slot /></main><footer class="site-footer"><div><span class="route-label">ALPHA LINE / ARCHIVE</span><p>تعريبات عربية تحفظ إيقاع الحكاية.</p></div><p>© {new Date().getFullYear()} Alpha Line</p></footer><MobileNav active={active} /></div></body></html>
