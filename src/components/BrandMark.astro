---
// Chronos Archive: «بوابة الأرشيف» — رمز متجه ثابت، مع مسارات لغوية متقاربة ومحطة سماوية واحدة.
import ArchiveGateMark from "./ArchiveGateMark.astro";
interface Props { variant?: "symbol" | "compact" | "lockup"; }
const { variant = "symbol" } = Astro.props;
---

{variant === "lockup" ? (
  <span class="brand-archive-lockup">
    <ArchiveGateMark class="brand-archive-mark brand-archive-mark-desktop" />
    <span class="brand-archive-copy">
      <span class="brand-wordmark"><b>ALPHA</b><em>LINE</em></span>
      <span class="brand-arabic" lang="ar">ألفا لاين <i>ARCHIVE 00</i></span>
    </span>
  </span>
) : variant === "compact" ? (
  <span class="brand-archive-compact">
    <ArchiveGateMark class="brand-archive-mark" />
    <span class="brand-compact-wordmark"><b>ALPHA</b><em>LINE</em></span>
  </span>
) : (
  <ArchiveGateMark class="brand-archive-mark" />
)}
