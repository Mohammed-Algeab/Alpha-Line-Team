---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts, projects } from "../data/content";
const entries = [...projects.map((project) => ({ title: project.arabicTitle, sub: project.title, href: `/translations/${project.slug}/`, type: "تعريبة" })), ...posts.map((post) => ({ title: post.title, sub: post.excerpt, href: `/blog/${post.slug}/`, type: "سجل" }))];
---
<BaseLayout title="البحث — Alpha Line" description="بحث ثابت داخل أرشيف Alpha Line."><section class="page-hero compact"><span class="route-label">ARCHIVE / SEARCH</span><h1>ابحث في الأرشيف</h1><p>البحث يعمل داخل الصفحة من دون قاعدة بيانات أو طلبات خارجية.</p></section><section class="page-content search-page"><label for="site-search">كلمة البحث</label><input id="site-search" type="search" placeholder="مثال: شتاينز أو إصدار" autocomplete="off" /><p class="search-count">كل السجلات</p><div class="search-results">{entries.map((entry) => <a href={entry.href} data-search={`${entry.title} ${entry.sub} ${entry.type}`}><small>{entry.type}</small><strong>{entry.title}</strong><span>{entry.sub}</span></a>)}</div></section><script>const input = document.querySelector('#site-search'); const count = document.querySelector('.search-count'); const rows = [...document.querySelectorAll('[data-search]')]; input?.addEventListener('input', () => { const query = input.value.trim().toLowerCase(); let shown = 0; rows.forEach((row) => { const visible = !query || row.dataset.search?.toLowerCase().includes(query); row.toggleAttribute('hidden', !visible); if (visible) shown += 1; }); if (count) count.textContent = query ? `${shown} نتيجة` : 'كل السجلات'; });</script></BaseLayout>
